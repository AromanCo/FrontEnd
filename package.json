{
  "name": "aroman-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "types:api": "openapi-typescript docs/openapi.m1a.json -o src/lib/api/generated.ts",
    "screenshots": "node scripts/capture.mjs",
    "screenshots:visual": "node scripts/capture-visual-alignment.mjs",
    "test:browser": "node scripts/browser-journey.mjs",
    "test:browser:responsive": "node scripts/responsive-studio-journey.mjs",
    "test:browser:guided": "node scripts/guided-studio-journey.mjs && node scripts/guided-handoff-route-journey.mjs",
    "test:browser:integration": "node scripts/integrated-qa-journey.mjs",
    "test:browser:auth": "node scripts/auth-browser-journey.mjs",
    "test:browser:guided-save": "node scripts/guided-save-account-journey.mjs",
    "test:browser:guided-creative-save": "node scripts/guided-creative-save-journey.mjs",
    "test:browser:save-retry": "node scripts/guided-creative-save-journey.mjs --fail-first-save",
    "test:browser:save-session-expiry": "node scripts/guided-creative-save-journey.mjs --expire-first-save",
    "test:browser:save-pending": "node scripts/guided-creative-save-journey.mjs --defer-first-save",
    "test:browser:mobile-rtl": "node scripts/mobile-rtl-journey.mjs",
    "test:browser:firefox": "BROWSER_ENGINE=firefox node scripts/mobile-rtl-journey.mjs",
    "test:browser:webkit": "BROWSER_ENGINE=webkit node scripts/mobile-rtl-journey.mjs"
  },
  "dependencies": {
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.64.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
