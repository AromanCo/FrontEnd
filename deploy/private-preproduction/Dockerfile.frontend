# Build context is the reviewed Frontend checkout after the M6-A25 public-showcase
# candidate has been built and verified. NODE_RUNTIME_IMAGE must be a Node 22+ digest.
ARG NODE_RUNTIME_IMAGE
FROM ${NODE_RUNTIME_IMAGE}
RUN node -e 'if (Number(process.versions.node.split(".")[0]) < 22) throw new Error("Node 22+ is required for the reviewed runtime")'

WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY .next ./.next
COPY public ./public
COPY next.config.mjs ./next.config.mjs
COPY scripts/public-showcase-start.mjs scripts/backend-pin.mjs ./scripts/
COPY src/lib/public-showcase-config.mjs ./src/lib/public-showcase-config.mjs

USER 10001:10001
EXPOSE 3000
CMD ["node", "scripts/public-showcase-start.mjs", "--hostname", "0.0.0.0", "--port", "3000"]
